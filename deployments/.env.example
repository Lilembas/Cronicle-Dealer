# ==========================================
# Cronicle-Dealer 环境变量配置模板
# 复制此文件为 .env 并在 docker-compose.yml 中使用或加载到环境中
# ==========================================

# -----------------
# 1. 安全配置 (强烈建议在生产环境修改)
# -----------------
# Web/API 鉴权使用的 JWT 密钥
CRONICLE_SECURITY_JWT_SECRET=change-me-in-production-to-a-secure-random-string

# Manager 和 Worker 之间内部通信的认证 Token (两边必须一致)
CRONICLE_SECURITY_AUTH_TOKEN=change-me-in-production
CRONICLE_WORKER_AUTH_TOKEN=change-me-in-production

# -----------------
# 2. 数据库配置
# -----------------
# 驱动类型: sqlite 或 postgres
CRONICLE_DATABASE_DRIVER=sqlite
# SQLite 时有效:
CRONICLE_DATABASE_PATH=/app/data/cronicle.db

# 如果 CRONICLE_DATABASE_DRIVER=postgres，需配置以下项:
# CRONICLE_DATABASE_HOST=db
# CRONICLE_DATABASE_PORT=5432
# CRONICLE_DATABASE_DATABASE=cronicle
# CRONICLE_DATABASE_USERNAME=cronicle
# CRONICLE_DATABASE_PASSWORD=cronicle_password

# Postgres 官方镜像使用的初始化环境变量 (可选配置)
POSTGRES_USER=cronicle
POSTGRES_PASSWORD=cronicle_password
POSTGRES_DB=cronicle

# -----------------
# 3. Redis 配置
# -----------------
CRONICLE_REDIS_HOST=redis
CRONICLE_REDIS_PORT=6379
# CRONICLE_REDIS_PASSWORD=

# -----------------
# 4. 任务历史与日志清理策略
# -----------------
# 任务执行记录保留天数
CRONICLE_MANAGER_HISTORY_EVENT_RETENTION_DAYS=30
# 节点负载历史保留天数
CRONICLE_MANAGER_HISTORY_METRIC_RETENTION_DAYS=7

# -----------------
# 5. Worker 节点配置
# -----------------
# Worker 连接到 Manager 的 gRPC 地址
CRONICLE_WORKER_MANAGER_ADDRESS=manager:9090
# Worker 拥有的标签 (JSON 格式)
CRONICLE_WORKER_NODE_TAGS=["default", "docker"]

# -----------------
# 6. 其他配置
# -----------------
# 日志级别: debug, info, warn, error
CRONICLE_LOGGING_LEVEL=info
